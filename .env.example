# Copy this file to .env and fill in your own Supabase project's values.
# Never commit the real .env file — it's already covered by .gitignore.

# Found in Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put SUPABASE_SERVICE_ROLE_KEY here or anywhere in the frontend.
# Service-role operations belong in Supabase Edge Functions, configured
# as Edge Function secrets, not Vite env vars.
